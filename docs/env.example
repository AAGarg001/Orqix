# Actual CPCB browser automation
WORKER_RUNTIME=local
METADATA_STORE=mongodb
PYTHON_EXECUTABLE=.venv/Scripts/python.exe
PORT=4000
PUBLIC_ORIGIN=http://localhost:5173
# Real mode: copy your ROTATED Atlas URI here; never commit this file.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.tiqhhgf.mongodb.net/cpcb_platform
MAX_CONCURRENT_JOBS=4
MAX_JOBS_PER_USER=2
WORKER_IMAGE=cpcb-worker:local
WORKER_NETWORK=cpcb-workers
ARTIFACT_TTL_MINUTES=60
JOB_TIMEOUT_MINUTES=120
SESSION_HOURS=12
COOKIE_SECURE=false
# Use 1 only behind exactly one trusted reverse proxy, with API port not public.
TRUST_PROXY_HOPS=0
REGISTRATION_ENABLED=false

# Enterprise data is persisted in Atlas; do not use memory outside tests.
ENFORCE_ASSIGNMENTS=true
# Hosted private files can use Cloudinary authenticated raw assets.
PRIVATE_FILE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# PRIVATE_FILE_STORAGE=mongodb keeps private files in Atlas GridFS instead.
# Optional: set PRIVATE_FILE_STORAGE=spaces to use DigitalOcean Spaces instead.
# SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
# SPACES_REGION=blr1
# SPACES_BUCKET=your-private-bucket
# SPACES_ACCESS_KEY=...
# SPACES_SECRET_KEY=...
# REDIS_URL=redis://localhost:6379
# Graph app must have organizational Mail.Send permissions, with admin consent.
# GRAPH_TENANT_ID=...
# GRAPH_CLIENT_ID=...
# GRAPH_CLIENT_SECRET=...
# GRAPH_SENDER=reports@your-company.example
# AI provider is optional. Without it, the UI labels answers as knowledge-base guides.
# AI_MODEL=provider/configured-model
# AI_GATEWAY_API_KEY=...

# Optional real payment-provider integration. Never put secrets in VITE_* variables.
# For dummy purchases use your Razorpay Dashboard TEST keys (never live keys).
# RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# Webhook URL: https://your-host/api/billing/razorpay/webhook
# Seller/customer tax review must be configured by authorized finance users in the app.
# Sandbox UI: /client/subscriptions. Test purchases use separate records and test receipts;
# they never change live entitlements, revenue or tax invoices. Restart API after editing keys.
